FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    build-essential \
    cmake \
    ninja-build \
    pkg-config \
    llvm \
    file \
    gcc-aarch64-linux-gnu \
    g++-aarch64-linux-gnu \
    binutils-aarch64-linux-gnu \
    libc6-dev-arm64-cross \
    libvulkan-dev \
    mesa-common-dev \
    python3 \
    git \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
